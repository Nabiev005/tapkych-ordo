// «Тапкыч ордо» — базанын схемасы
// SQLite enum'дарды колдобогондуктан, абалдар String түрүндө сакталат.
// Мүмкүн болгон маанилер src/types.ts файлында сүрөттөлгөн.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Мугалимдердин аккаунттары. Башкы алып баруучу (.env’деги ADMIN_USER) бул таблицада жок.
model Teacher {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  name         String
  passwordHash String
  email        String?  @unique // Gmail — «Google менен кирүү» үчүн
  createdAt    DateTime @default(now())

  questions   Question[]
  games       Game[]
  assignments Assignment[]
}

/// Суроолор банкы. ownerId = null — башкы алып баруучунун банкы, болбосо мугалимдики.
model Question {
  id         Int       @id @default(autoincrement())
  ownerId    Int?
  round      String // ROUND1 | ROUND2 | FINAL
  order      Int
  type       String    @default("CHOICE") // CHOICE | TF | ORDER
  category   String    @default("") // тема: Тарых, География…
  difficulty String    @default("MEDIUM") // EASY | MEDIUM | HARD
  text       String
  imageUrl   String?
  audioUrl   String?
  optionA    String
  optionB    String
  optionC    String
  optionD    String
  correct    String // CHOICE/TF: A|B|C|D; ORDER: туура тартип, мис. "CADB"
  /// Оюнда суралган суроо архивге өтөт (кийинки оюнда кайталанбайт)
  archived   Boolean   @default(false)
  usedCount  Int       @default(0)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  owner         Teacher?       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  gameQuestions GameQuestion[]

  @@index([ownerId, round, archived, order])
}

model Game {
  id                Int       @id @default(autoincrement())
  ownerId           Int?
  code              String    @unique // кошулуу коду (6 сан)
  title             String? // мис. «1-курстар арасындагы таймаш»
  status            String    @default("LOBBY") // LOBBY | ROUND1 | ROUND2 | FINAL | FINISHED
  phase             String    @default("IDLE") // IDLE | READY | QUESTION | REVEAL | ROUND_END
  paused            Boolean   @default(false)
  showLeaderboard   Boolean   @default(false) // рейтинг экранда көрсөтүлүп жатабы
  currentIndex      Int       @default(-1) // учурдагы турдагы суроонун индекси
  questionEndsAt    DateTime?
  pausedRemainingMs Int?

  // Жөндөөлөр
  pointsPerCorrect   Int     @default(1)
  timerSeconds       Int     @default(15)
  round1Count        Int     @default(10)
  round2Count        Int     @default(10)
  finalQuestionCount Int     @default(5)
  advanceToRound2    Int     @default(6)
  advanceToFinal     Int     @default(3)
  expectedPlayers    Int     @default(12)
  soundEnabled       Boolean @default(true)
  teamMode           Boolean @default(false) // топ топко каршы
  speedBonus         Int     @default(0) // тез жооп үчүн кошумча упай (0 — өчүк)
  fiftyFifty         Boolean @default(false) // «50/50» жардамы
  selectionMode      String  @default("ORDER") // ORDER — турлар боюнча; DIFFICULTY — кыйынчылык боюнча
  categories         String  @default("") // үтүр менен: «Тарых,География» (бош — баары)

  createdAt  DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  owner       Teacher?          @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  players     Player[]
  questions   GameQuestion[]
  answers     Answer[]
  adjustments ScoreAdjustment[]
}

model Player {
  id              Int       @id @default(autoincrement())
  gameId          Int
  name            String
  pin             String // жеке 4 орундуу PIN
  token           String?   @unique // кайра кошулуу үчүн
  status          String    @default("ACTIVE") // ACTIVE | ELIMINATED | KICKED
  eliminatedAfter String? // ROUND1 | ROUND2 | FINAL
  seat            Int       @default(0) // тизмедеги тартиби
  studentId       Int? // студенттер тизмесиндеги жазуу (рейтинг үчүн)
  team            String    @default("") // командалык режимде — тобу
  fiftyQuestionId Int? // «50/50» колдонулган суроо (бир оюнда бир жолу)
  fiftyHidden     String? // жашырылган эки ката вариант, мис. "BD"
  joinedAt        DateTime?
  createdAt       DateTime  @default(now())

  game        Game              @relation(fields: [gameId], references: [id], onDelete: Cascade)
  student     Student?          @relation(fields: [studentId], references: [id], onDelete: SetNull)
  answers     Answer[]
  adjustments ScoreAdjustment[]

  @@unique([gameId, pin])
  @@index([gameId])
  @@index([studentId])
}

/// Оюн башталганда суроонун көчүрмөсү сакталат —
/// банктагы суроо кийин өзгөртүлсө да, жыйынтык бузулбайт.
model GameQuestion {
  id         Int       @id @default(autoincrement())
  gameId     Int
  questionId Int?
  round      String
  order      Int
  type       String    @default("CHOICE")
  category   String    @default("")
  difficulty String    @default("MEDIUM")
  text       String
  imageUrl   String?
  audioUrl   String?
  optionA    String
  optionB    String
  optionC    String
  optionD    String
  correct    String
  startedAt  DateTime?
  endsAt     DateTime?
  revealedAt DateTime?

  game     Game           @relation(fields: [gameId], references: [id], onDelete: Cascade)
  question Question?      @relation(fields: [questionId], references: [id], onDelete: SetNull)
  answers  Answer[]
  votes    AudienceVote[]

  @@unique([gameId, round, order])
}

model Answer {
  id             Int      @id @default(autoincrement())
  gameId         Int
  playerId       Int
  gameQuestionId Int
  choice         String // A | B | C | D; ORDER үчүн тартип, мис. "CADB"
  isCorrect      Boolean
  responseMs     Int
  points         Int // бонусту кошо алганда
  bonus          Int      @default(0) // тез жооп бонусу
  createdAt      DateTime @default(now())

  game         Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  player       Player       @relation(fields: [playerId], references: [id], onDelete: Cascade)
  gameQuestion GameQuestion @relation(fields: [gameQuestionId], references: [id], onDelete: Cascade)

  @@unique([playerId, gameQuestionId]) // бир суроого бир гана жооп
  @@index([gameId])
}

/// Залдагы көрүүчүлөрдүн добушу (упайга таасир этпейт)
model AudienceVote {
  id             Int      @id @default(autoincrement())
  gameQuestionId Int
  voterId        String
  choice         String
  createdAt      DateTime @default(now())

  gameQuestion GameQuestion @relation(fields: [gameQuestionId], references: [id], onDelete: Cascade)

  @@unique([gameQuestionId, voterId])
}

/// Алып баруучу упайды кол менен оңдогондо
model ScoreAdjustment {
  id        Int      @id @default(autoincrement())
  gameId    Int
  playerId  Int
  round     String
  delta     Int
  reason    String?
  createdAt DateTime @default(now())

  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([gameId])
}

/// Студенттердин туруктуу тизмеси — бардык оюндар боюнча рейтинг ушул аркылуу эсептелет
model Student {
  id        Int      @id @default(autoincrement())
  name      String
  className String   @default("") // мис. 9А
  createdAt DateTime @default(now())

  players     Player[]
  submissions Submission[]

  @@unique([name, className])
}

/// Рейтингдин сезондору (мис. «Күзгү сезон 2026»)
model Season {
  id        Int      @id @default(autoincrement())
  name      String
  startsAt  DateTime
  endsAt    DateTime
  createdAt DateTime @default(now())
}

/// Үй тапшырмасы: студенттер шилтеме аркылуу өз убагында иштешет
model Assignment {
  id           Int       @id @default(autoincrement())
  ownerId      Int?
  code         String    @unique
  title        String
  timerSeconds Int       @default(30)
  active       Boolean   @default(true)
  closesAt     DateTime?
  createdAt    DateTime  @default(now())

  owner       Teacher?             @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  questions   AssignmentQuestion[]
  submissions Submission[]
}

model AssignmentQuestion {
  id           Int     @id @default(autoincrement())
  assignmentId Int
  order        Int
  type         String  @default("CHOICE")
  category     String  @default("")
  text         String
  imageUrl     String?
  audioUrl     String?
  optionA      String
  optionB      String
  optionC      String
  optionD      String
  correct      String

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, order])
}

model Submission {
  id               Int       @id @default(autoincrement())
  assignmentId     Int
  studentId        Int?
  name             String
  className        String    @default("")
  token            String    @unique
  index            Int       @default(0) // учурдагы суроо
  currentStartedAt DateTime?
  answers          String    @default("[]") // JSON: [{ choice, correct, ms }]
  score            Int       @default(0)
  correct          Int       @default(0)
  startedAt        DateTime  @default(now())
  finishedAt       DateTime?

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    Student?   @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@unique([assignmentId, studentId])
}

/// Жүктөлгөн сүрөттөр жана аудио базада сакталат (сервер кайра иштетилгенде да жоголбойт)
model Upload {
  id        String   @id // файлдын аты, мис. 3f2a….jpg
  mime      String
  data      Bytes
  createdAt DateTime @default(now())
}
